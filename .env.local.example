# ASR 语音识别 + TTS 语音合成（共用）
VOLCENGINE_SPEECH_APPID=your_appid_here
VOLCENGINE_SPEECH_TOKEN=your_token_here

# LLM（豆包 Doubao）
VOLCENGINE_ARK_API_KEY=your_ark_api_key_here
VOLCENGINE_ARK_ENDPOINT_ID=your_endpoint_id_here

# 异步 ASR（新版语音控制台 API Key）
VOLCENGINE_SPEECH_API_KEY=

# 火山引擎 IAM（ASR / TOS 等服务共用）
VOLCENGINE_ACCESS_KEY=your_access_key_here
VOLCENGINE_SECRET_KEY=your_secret_key_here

# TOS 云端存储
VOLCENGINE_TOS_ENDPOINT=tos-cn-beijing.volces.com
VOLCENGINE_TOS_BUCKET=your-bucket-name

# Worktree 标识（用于 dev flavor 区分不同开发实例）
# 不设置时 dev flavor 使用默认包名 info.colinhan.glimmer.dev
# WORKTREE=feature-xxx

# 高德地图 Web 服务（位置地标逆地理 + 天气实况）
AMAP_WEB_KEY=your_amap_web_key_here

# === ASR 识别增强（可选）===
# 不设置时 ASR 正常工作，仅无个性化增强；非 prod 必需项，不纳入 build.sh 校验。
# 专名热词：人名/产品/项目等，逗号分隔。来源须为用户确认（金标准），勿从 ASR 输出自动抽取，以免错误固化。
ASR_HOTWORDS=
# 个性化上下文（口音/常驻地/语言/话题），自然语言一句话，注入 ASR dialog_ctx。
ASR_CONTEXT_PROMPT=
